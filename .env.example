# ═══════════════════════════════════════════════════════════════
#  Bud AI Telegram Bot — Environment Variables
#  Copy this file to .env for local development.
#  On Railway, set these via Dashboard → Variables.
# ═══════════════════════════════════════════════════════════════

# ─── Telegram (REQUIRED) ───
BOT_TOKEN=your_telegram_bot_token_from_botfather

# ─── NEAR AI Cloud — OpenAI-compatible (REQUIRED) ───
NEAR_AI_API_KEY=your_near_ai_api_key_from_cloud.near.ai
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=openai/gpt-5.2
NEAR_AI_IMAGE_MODEL=dall-e-3
NEAR_AI_IMAGE_SIZE=1024x1024
# Model used for fast/streaming responses (default: openai/gpt-4o)
FAST_MODEL=openai/gpt-4o
# Comma-separated list of available models for the /model command
AVAILABLE_MODELS=openai/gpt-5.2,openai/gpt-4o,openai/o3-mini
# Streaming parameters — tweak if responses feel sluggish or too fast
STREAM_INITIAL_INTERVAL=0.35
STREAM_INITIAL_UPDATES=3
# Separate base URL and API key for image generation (if different from the main LLM API).
# Leave empty to use NEAR_AI_BASE_URL and NEAR_AI_API_KEY.
NEAR_AI_IMAGE_BASE_URL=
NEAR_AI_IMAGE_API_KEY=

# ─── PostgreSQL ───
# Railway auto-provides DATABASE_URL when you add a PostgreSQL plugin.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Web Search (Tavily) ───
# Get a free API key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# ─── Admin ───
# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# ─── Conversation Settings ───
MAX_MESSAGES_PER_CONVERSATION=50
MAX_TOKENS_PER_CONVERSATION=128000
MAX_RESPONSE_TOKENS=4096

# ─── Rate Limiting ───
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DAILY_CAP=200

# ─── File Handling ───
FILE_READER_MAX_CHARS=15000
FILE_MAX_SIZE_MB=20
BLOCKED_FILE_EXTENSIONS=.exe,.bat,.sh,.com,.dll,.msi,.scr,.pif,.vbs,.ps1,.jar,.app,.cmd,.reg,.sys,.bin,.elf

# ─── Dashboard ───
# Set this to your admin dashboard URL to receive real-time metrics.
# Events are sent to {DASHBOARD_URL}/api/events/report
# Leave empty to disable dashboard reporting.
DASHBOARD_URL=

# ─── Streaming ───
STREAM_EDIT_INTERVAL=1.5

# ─── Token Estimation ───
TOKEN_ESTIMATION_CHARS_PER_TOKEN=4

# ─── Security ───
MAX_SYSTEM_PROMPT_LENGTH=2000

# ─── Railway-specific ───
# Railway sets this automatically for real-time log streaming.
# PYTHONUNBUFFERED=1

# ─── Ports ───
# Railway auto-assigns $PORT. The bot falls back to 8080 if unset.
# Only override HEALTH_PORT or WEBHOOK_PORT if you need a specific port.
# HEALTH_PORT=8080
# WEBHOOK_PORT=8080

# ─── Webhook Mode (PRIMARY for Railway) ───
# Set USE_WEBHOOK=0 to fall back to long-polling (not recommended for Railway).
USE_WEBHOOK=1
# On Railway, set this to: https://<your-project>.up.railway.app
# If unset, the bot gracefully falls back to polling mode (health-check only).
WEBHOOK_URL=https://your-app.up.railway.app
WEBHOOK_PATH=/webhook
# Required when USE_WEBHOOK=1. A long random phrase Telegram sends as
# X-Telegram-Bot-Api-Secret-Token so strangers cannot post fake updates.
WEBHOOK_SECRET_TOKEN=replace-with-a-long-random-phrase

# Same phrase as DASHBOARD_INGEST_SECRET on the dashboard service.
DASHBOARD_INGEST_SECRET=